PORT=3000                                   # Port number for backend

DEMO_USER_USERNAME=username                 # Username for user account
DEMO_USER_PASSWORD=password                 # Password for user account
DEMO_WORKER_ID=worker                       # ID for worker
DEMO_WORKER_SECRET=secretkey                # Secret key for worker
HELIOS_URL=http://nginx                     # Internal URL used by the loader in Docker Compose

JWT_SECRET=secretkey                        # JWT secret

# S3-compatible storage for backend (local MinIO defaults)
S3_BUCKET=helios-dev-bucket                 # S3 bucket name
S3_REGION=us-east-1                         # S3 region
S3_ENDPOINT=http://minio:9000                # Local MinIO S3-compatible endpoint
S3_ACCESS_KEY_ID=helios                     # Local MinIO access key
S3_SECRET_ACCESS_KEY=helios-secret-key      # Local MinIO secret key (minimum 8 characters)
S3_FORCE_PATH_STYLE=true                    # MinIO requires path-style URLs in local development

# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.sections.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres 
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the 
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

POSTGRES_DB=helios
POSTGRES_USER=helios
POSTGRES_PASSWORD=helios
DATABASE_URL="postgresql://helios:helios@postgres:5432/helios?schema=public"

REDIS_USERNAME=default
REDIS_PASSWORD=helios
REDIS_HOST=redis
REDIS_PORT=6379

POSTHOG_KEY=secretkey		                # Project token for PostHog events
POSTHOG_HOST=                               # PostHog host

# Loader worker concurrency. BullMQ allows one loader process to process this many jobs concurrently.
# Start with the default and tune while watching backend, Redis, database, S3, proxy, and target-site limits.
LOADER_CONCURRENCY=5
